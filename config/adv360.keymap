#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        email: email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "EMAIL";
            bindings = <&none &kp L &kp O &kp R &kp E &kp N &kp Z &kp O &kp S &kp P &kp A &kp D &kp A &kp N2 &kp N0 &kp N0 &kp N2 &kp AT &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
        };

        phone: phone {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "PHONE";
            bindings = <&none &kp N0 &kp N6 &kp N4 &kp N0 &kp N8 &kp N2 &kp N0 &kp N8 &kp N4 &kp N0>;
        };

        euro: euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "Euro";
            bindings = <&kp RA(E)>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TILDE      &kp DOLLAR  &kp AT     &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &tog 2                                                                                       &mo 3        &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp EQUAL          &kp MINUS        &caps_word
&kp TAB        &kp SEMI    &kp COMMA  &kp DOT           &kp P           &kp Y                 &kp PRINTSCREEN                                                                              &kp LA(TAB)  &kp F                  &kp G            &kp C              &kp R              &kp L            &kp BSLH
&kp ESC        &kp A       &kp O      &kp E             &kp U           &kp I                 &tog 4                     &kp LCTRL       &kp LALT    &kp LGUI  &kp RCTRL                   &kp LA(TAB)  &kp D                  &kp H            &kp T              &kp N              &kp S            &kp RET
&kp LC(LEFT)   &kp LEFT    &kp Q      &kp J             &kp K           &kp X                                                            &kp DEL     &kp HOME                                           &kp B                  &kp M            &kp W              &kp V              &kp Z            &kp LC(RIGHT)
&kp LA(LC(T))  &kp PG_UP   &kp PG_DN  &kp LEFT          &kp RIGHT                                              &kp BSPC  &kp LEFT_SHIFT  &mo 1       &kp END   &kp RIGHT_SHIFT  &kp SPACE                                      &kp UP           &kp DOWN           &kp K_VOLUME_DOWN  &kp K_VOLUME_UP  &kp K_PLAY_PAUSE
            >;
        };

        keypad {
            bindings = <
&trans            &trans     &trans     &trans     &trans     &trans  &trans                                                                &kp LOCKING_NUM  &kp ASTERISK  &kp KP_SLASH     &kp EQUAL    &kp MINUS       &trans      &trans
&trans            &none      &kp COMMA  &kp DOT    &trans     &trans  &kp LA(F4)                                                            &email           &kp N1        &kp N2           &kp N3       &trans          &trans      &trans
&trans            &kp LC(A)  &kp LC(C)  &kp LC(X)  &kp LC(V)  &trans  &kp K_COFFEE          &trans     &trans    &trans  &trans             &phone           &kp N4        &kp N5           &kp N6       &trans          &trans      &trans
&kp LC(LA(LEFT))  &trans     &trans     &trans     &trans     &trans                                   &trans    &trans                                      &kp N7        &kp N8           &kp N9       &none           &trans      &kp LC(LA(RIGHT))
&trans            &trans     &trans     &trans     &trans                           &trans  &kp LSHFT  &trans    &trans  &kp RSHFT  &kp N0                                 &kp LC(LS(TAB))  &kp LC(TAB)  &kp K_PREVIOUS  &kp K_NEXT  &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &none                                                     &trans  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                    &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans    &trans  &trans          &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                          &trans    &trans                          &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans    &trans  &trans  &trans                  &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                                        &trans        &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                                                  &bootloader   &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none               &none  &none    &bt BT_CLR  &none                        &stp STP_BAT  &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                                    &none    &none                                                  &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                                    &none  &none  &none    &none       &bl BL_TOG  &rgb_ug RGB_TOG                       &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        qwerty {
            display-name = "Qwerty";
            bindings = <
&kp TILDE      &kp EXCL   &kp AT     &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &tog 2                                                                            &mo 3        &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp EQUAL          &kp MINUS        &kp CAPSLOCK
&kp TAB        &kp Q      &kp W      &kp E             &kp R           &kp T                 &kp PRINTSCREEN                                                                   &kp K_CALC   &kp Y                  &kp U            &kp I              &kp O              &kp P            &kp BSLH
&kp ESC        &kp A      &kp S      &kp D             &kp F           &kp G                 &none                      &kp SPACE  &kp LALT    &kp LGUI  &kp RCTRL             &kp LA(TAB)  &kp H                  &kp J            &kp K              &kp L              &kp SEMI         &kp RET
&kp LC(LEFT)   &kp Z      &kp X      &kp C             &kp V           &kp B                                                       &kp DEL     &kp HOME                                     &kp N                  &kp M            &kp COMMA          &kp DOT            &kp APOS         &kp LC(RIGHT)
&kp LA(LC(T))  &kp PG_UP  &kp PG_DN  &kp LEFT          &kp RIGHT                                              &kp BSPC  &kp LSHFT  &mo 1       &kp END   &kp RSHFT  &kp SPACE                                      &kp UP           &kp DOWN           &kp K_VOLUME_DOWN  &kp K_VOLUME_UP  &kp K_PLAY_PAUSE
            >;
        };
    };
};
